---
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicationCard from "../components/PublicationCard.astro";
import PostCard from "../components/PostCard.astro";
import { site } from "../config";
import { publications } from "../data/publications";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import bioImage from "../../Bio.png";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 2);

const directions = [
  {
    index: "01",
    title: "Representation Learning",
    description:
      "Learn robust and transferable representations that generalize across changing environments, sensing conditions, and data distributions."
  },
  {
    index: "02",
    title: "Multimodal Understanding",
    description:
      "Learn to integrate visual, linguistic, and other sensory information to understand complex real-world phenomena."
  },
  {
    index: "03",
    title: "Intelligent Systems",
    description:
      "Develop autonomous systems that combine perception, reasoning, and decision-making to interact effectively with dynamic environments."
  }
];

const featuredPublications = publications.filter((publication) => publication.featured);
const homepagePublications =
  featuredPublications.length > 0 ? featuredPublications : publications.slice(0, 1);
---

<BaseLayout>
  <section class="hero page-shell">
    <div class="hero-primary">
      <figure class="hero-portrait">
        <Image
          src={bioImage}
          alt={`Portrait of ${site.fullName}`}
          width={220}
          height={230}
          loading="eager"
          quality={85}
        />
      </figure>
      <h1>I study how machines<br /><em>learn to see and act</em></h1>
    </div>
    <div class="hero-bottom">
      <p class="hero-intro">{site.description}</p>
      <div class="hero-facts" aria-label="Profile">
        <p><span>Affiliation</span>{site.institution}</p>
        <p><span>Location</span>{site.location}</p>
      </div>
    </div>
  </section>

  <section class="section page-shell" aria-labelledby="research-heading">
    <div class="section-heading">
      <p class="eyebrow">Selected directions</p>
      <h2 id="research-heading">Research</h2>
      <a class="arrow-link" href="/research">Projects <span aria-hidden="true">→</span></a>
    </div>
    <div class="project-grid">
      {directions.map((direction) => (
        <a class="research-card" href="/research">
          <svg class="research-motif" viewBox="0 0 400 168" preserveAspectRatio="none" aria-hidden="true">
            {direction.index === "01" && (
              <Fragment>
                <circle class="c1-d1" cx="40" cy="30" r="2.5" fill="var(--line)" />
                <circle class="c1-d2" cx="66" cy="128" r="2.5" fill="var(--line)" />
                <circle class="c1-d3" cx="140" cy="36" r="2.5" fill="var(--line)" />
                <circle class="c1-d4" cx="188" cy="132" r="2.5" fill="var(--line)" />
                <circle class="c1-d5" cx="252" cy="44" r="2.5" fill="var(--line)" />
                <circle class="c1-d6" cx="56" cy="80" r="2.5" fill="var(--line)" />
              </Fragment>
            )}
            {direction.index === "02" && (
              <Fragment>
                <circle class="c2-ring" cx="284" cy="84" r="0" fill="none" stroke="var(--accent)" stroke-width="1.5" />
                <g class="c2-vision">
                  <rect x="34" y="30" width="30" height="22" rx="1" fill="none" stroke="var(--accent)" stroke-width="1.5" />
                  <circle cx="49" cy="41" r="5" fill="none" stroke="var(--accent)" stroke-width="1.5" />
                </g>
                <g class="c2-text">
                  <line x1="30" y1="82" x2="66" y2="82" stroke="var(--signal)" stroke-width="2" stroke-linecap="round" />
                  <line x1="30" y1="92" x2="58" y2="92" stroke="var(--signal)" stroke-width="2" stroke-linecap="round" />
                  <line x1="30" y1="102" x2="64" y2="102" stroke="var(--signal)" stroke-width="2" stroke-linecap="round" />
                </g>
                <g class="c2-audio">
                  <line x1="34" y1="128" x2="34" y2="146" stroke="var(--muted)" stroke-width="2" stroke-linecap="round" />
                  <line x1="44" y1="120" x2="44" y2="154" stroke="var(--muted)" stroke-width="2" stroke-linecap="round" />
                  <line x1="54" y1="132" x2="54" y2="142" stroke="var(--muted)" stroke-width="2" stroke-linecap="round" />
                  <line x1="64" y1="124" x2="64" y2="150" stroke="var(--muted)" stroke-width="2" stroke-linecap="round" />
                </g>
              </Fragment>
            )}
            {direction.index === "03" && (
              <Fragment>
                <path d="M 108,120 L 292,120 L 200,42 Z" fill="none" stroke="var(--line)" stroke-width="1.5" />
                <circle class="c3-node n1" cx="108" cy="120" r="5" fill="var(--accent)" />
                <circle class="c3-node n2" cx="292" cy="120" r="5" fill="var(--accent)" />
                <circle class="c3-node n3" cx="200" cy="42" r="5" fill="var(--accent)" />
                <circle class="c3-runner" cx="0" cy="0" r="5" fill="var(--signal)" />
              </Fragment>
            )}
          </svg>
          <div class="research-card-body">
            <span class="project-index">{direction.index}</span>
            <h3>{direction.title}</h3>
            <p>{direction.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section page-shell" aria-labelledby="publication-heading">
    <div class="section-heading">
      <p class="eyebrow">Recent work</p>
      <h2 id="publication-heading">Publications</h2>
      <a class="arrow-link" href="/publications">View all <span aria-hidden="true">→</span></a>
    </div>
    <div class="publication-list">
      {homepagePublications.map((publication) => <PublicationCard publication={publication} />)}
    </div>
  </section>

  <section class="section page-shell" aria-labelledby="notes-heading">
    <div class="section-heading">
      <p class="eyebrow">Field notes</p>
      <h2 id="notes-heading">Latest writing</h2>
      <a class="arrow-link" href="/blog">Read all notes <span aria-hidden="true">→</span></a>
    </div>
    <div class="post-grid">
      {posts.map((post) => (
        <PostCard
          slug={post.id}
          title={post.data.title}
          description={post.data.description}
          publishedAt={post.data.publishedAt}
          tags={post.data.tags}
          language={post.data.language}
        />
      ))}
    </div>
  </section>
</BaseLayout>
