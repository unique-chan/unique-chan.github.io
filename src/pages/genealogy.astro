---
import BaseLayout from "../layouts/BaseLayout.astro";
import TreeMark from "../components/TreeMark.astro";
import { genealogy, genealogyMeta, MGP_BASE } from "../data/genealogy";

const { generations, span, origin } = genealogyMeta;
const pad = (n: number) => String(n).padStart(2, "0");
---

<BaseLayout title="Genealogy" description="Academic Genealogy">
  <div class="leaf-fall" aria-hidden="true"></div>

  <h1 class="sr-only">Academic Genealogy</h1>

  <section class="page-shell gen-wrap">
    <div class="gen-crest">
      <TreeMark size={160} class="gen-crest-mark" />
      <p>From Wolfgang Fabricius Capito to Yechan Kim</p>
    </div>

    <div class="gen-stats">
      <div class="gen-stat">
        <b>{generations}</b>
        <span>Generations</span>
      </div>
      <div class="gen-stat">
        <b>{span}</b>
        <span>Recorded span</span>
      </div>
      <div class="gen-stat">
        <b>{origin}</b>
        <span>Earliest record</span>
      </div>
    </div>

    <div class="gen-tree">
      {
        genealogy.map((row) => (
          <Fragment>
            {row.link !== "none" && (
              <div class={`gen-link is-${row.link}`} aria-hidden="true">
                <span />
              </div>
            )}
            <div class={`gen-row ${row.people.length > 1 ? "is-pair" : "is-single"}`}>
              {row.people.map((person) => (
                <article
                  class={`gen-card${person.key ? " is-key" : ""}${person.terminal ? " is-terminal" : ""}`}
                >
                  <div class="gen-card-top">
                    {person.terminal ? (
                      <TreeMark size={30} class="gen-card-mark" />
                    ) : (
                      <span class="gen-idx">{row.level ? pad(row.level) : "→"}</span>
                    )}
                    {person.year && <span class="gen-year">{person.year}</span>}
                  </div>
                  <h3>
                    {person.mgp ? (
                      <a
                        href={`${MGP_BASE}${person.mgp}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        title={`${person.name} on the Mathematics Genealogy Project`}
                      >
                        {person.name}
                        <svg class="gen-out" viewBox="0 0 12 12" aria-hidden="true">
                          <path d="M4 2h6v6M10 2 3 9" />
                        </svg>
                      </a>
                    ) : (
                      person.name
                    )}
                  </h3>
                  {person.degree && <p class="gen-degree">{person.degree}</p>}
                  {person.institution && <p>{person.institution}</p>}
                  {person.note && <p class="gen-note">{person.note}</p>}
                </article>
              ))}
            </div>
          </Fragment>
        ))
      }
    </div>

    <p class="gen-source">
      Names link out to their record on the
      <a href="https://www.mathgenealogy.org/" target="_blank" rel="noopener noreferrer">
        Mathematics Genealogy Project</a
      >, where a record exists. Each year is when that degree was conferred.
    </p>
  </section>
</BaseLayout>

<script>
  const layer = document.querySelector<HTMLElement>(".leaf-fall");

  if (layer) {
    // reduced motion doesn't remove the leaves, it just calms them right down
    const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // a single lanceolate silhouette; variety comes from size, tint and motion
    const shape =
      '<svg viewBox="0 0 24 24"><path fill="currentColor" d="M2.5 21.5C2.5 11 8 3.5 21.5 2.5 22.5 16 15 21.5 2.5 21.5Z"/></svg>';

    const tints = ["var(--leaf-1)", "var(--leaf-2)", "var(--leaf-3)", "var(--leaf-4)"];

    const rand = (min: number, max: number) => min + Math.random() * (max - min);
    const count = calm ? 8 : window.innerWidth < 760 ? 14 : 24;
    const slow = calm ? 3 : 1;

    for (let i = 0; i < count; i++) {
      const fall = rand(13, 26) * slow;
      const leaf = document.createElement("span");
      leaf.className = "leaf";
      leaf.style.setProperty("--left", `${rand(-4, 100)}vw`);
      leaf.style.setProperty("--dur", `${fall}s`);
      // a negative delay seeds the field mid-flight instead of starting empty
      leaf.style.setProperty("--delay", `${-rand(0, fall)}s`);
      leaf.style.setProperty("--size", `${rand(15, 34)}px`);
      leaf.style.setProperty("--sway", `${calm ? 0 : rand(26, 70)}px`);
      leaf.style.setProperty("--spin", `${rand(6, 16) * slow}s`);
      leaf.style.setProperty("--turn", `${Math.random() < 0.5 ? -1 : 1}turn`);
      leaf.style.setProperty("--tint", tints[i % tints.length]);
      leaf.style.setProperty("--alpha", `${rand(0.55, 0.9)}`);
      leaf.innerHTML = `<i>${shape}</i>`;
      layer.append(leaf);
    }
  }
</script>
