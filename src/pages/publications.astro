---
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicationCard from "../components/PublicationCard.astro";
import PatentCard from "../components/PatentCard.astro";
import { publications } from "../data/publications";
import { patents } from "../data/patents";

const publicationTypeOrder = [
  "Conference",
  "Journal",
  "Preprint",
  "Workshop",
  "Korean Conference",
  "Korean Journal"
] as const;
const availableTypes = publicationTypeOrder.filter((type) =>
  publications.some((publication) => publication.type === type)
);
const allTypes = availableTypes.filter((type) => type === "Conference" || type === "Journal");
const koreanTypes = availableTypes.filter(
  (type) => type === "Korean Journal" || type === "Korean Conference"
);
const primaryTypes = availableTypes.filter(
  (type) => type !== "Korean Journal" && type !== "Korean Conference"
);
const patentStatusOrder = ["Filed", "Registered"] as const;
const patentStatuses = patentStatusOrder.filter((status) =>
  patents.some((patent) => patent.status === status)
);
const visiblePublications = publications;
const years = [
  ...new Set([
    ...visiblePublications.map((publication) => publication.year),
    ...patents.map((patent) => patent.year)
  ])
].sort((a, b) => b - a);
const types = [
  "All",
  ...primaryTypes,
  ...(patents.length ? ["Patent"] : []),
  ...(koreanTypes.length ? ["Korean"] : [])
];
---

<BaseLayout title="Publications" description="Peer-reviewed papers, preprints, and research artifacts.">
  <section class="page-intro page-shell">
    <p class="eyebrow">Research output</p>
    <h1>Publications</h1>
    <p class="lede">✝ denotes a corresponding author</p>
  </section>
  <section class="page-shell">
    <div class="publication-filters" aria-label="Filter publications by type">
      {types.map((type, index) =>
        type === "Korean" ? (
          <div class="publication-filter-group">
            <button
              type="button"
              class="filter-top"
              data-publication-filter="Korean"
              data-all-types={koreanTypes.join(",")}
              data-subgroup="korean"
              aria-pressed="false"
            >
              Korean Papers
            </button>
            <div class="publication-subfilters" data-subfilters="korean" aria-label="Filter Korean publications by type" hidden>
              {koreanTypes.map((koreanType) => (
                <button type="button" data-publication-filter={koreanType} aria-pressed="false">
                  {koreanType.replace("Korean ", "")}
                </button>
              ))}
            </div>
          </div>
        ) : type === "Patent" ? (
          <div class="publication-filter-group">
            <button
              type="button"
              class="filter-top"
              data-publication-filter="Patent"
              data-subgroup="patent"
              aria-pressed="false"
            >
              Patents
            </button>
            <div class="publication-subfilters" data-subfilters="patent" aria-label="Filter patents by status" hidden>
              {patentStatuses.map((status) => (
                <button type="button" data-publication-filter={status} data-filter-attr="status" aria-pressed="false">
                  {status}
                </button>
              ))}
            </div>
          </div>
        ) : (
          <button
            type="button"
            class="filter-top"
            data-publication-filter={type}
            data-all-types={type === "All" ? allTypes.join(",") : undefined}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            {type === "All" ? `All (${allTypes.map((t) => t[0]).join("+")})` : type}
          </button>
        )
      )}
    </div>
    {years.map((year) => (
      <div class="year-group" data-year-group>
        <h2>{year}</h2>
        <div class="publication-list">
          {
            visiblePublications
              .filter((publication) => publication.year === year)
              .map((publication) => <PublicationCard publication={publication} />)
          }
          {
            patents
              .filter((patent) => patent.year === year)
              .map((patent) => <PatentCard patent={patent} />)
          }
        </div>
      </div>
    ))}
  </section>
  <script>
    const topFilterButtons = document.querySelectorAll<HTMLButtonElement>(".filter-top");
    const subfilterContainers = document.querySelectorAll<HTMLElement>("[data-subfilters]");
    const publicationCards = document.querySelectorAll<HTMLElement>("[data-publication-type]");
    const yearGroups = document.querySelectorAll<HTMLElement>("[data-year-group]");

    const applyFilter = (button: HTMLButtonElement) => {
      const selectedType = button.dataset.publicationFilter ?? "All";
      const visibleTypes = button.dataset.allTypes
        ? button.dataset.allTypes.split(",")
        : [selectedType];
      const matchAttr = button.dataset.filterAttr === "status" ? "patentStatus" : "publicationType";

      publicationCards.forEach((card) => {
        card.hidden = !visibleTypes.includes(card.dataset[matchAttr] ?? "");
      });

      yearGroups.forEach((group) => {
        const visibleCards = group.querySelectorAll<HTMLElement>("[data-publication-type]:not([hidden])");
        group.hidden = visibleCards.length === 0;
      });
    };

    topFilterButtons.forEach((button) => {
      button.addEventListener("click", () => {
        topFilterButtons.forEach((item) => {
          item.setAttribute("aria-pressed", String(item === button));
        });

        const group = button.dataset.subgroup;
        subfilterContainers.forEach((container) => {
          container.hidden = container.dataset.subfilters !== group;
          container.querySelectorAll<HTMLButtonElement>("[data-publication-filter]").forEach((item) => {
            item.setAttribute("aria-pressed", "false");
          });
        });

        applyFilter(button);
      });
    });

    subfilterContainers.forEach((container) => {
      const buttons = container.querySelectorAll<HTMLButtonElement>("[data-publication-filter]");
      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          buttons.forEach((item) => {
            item.setAttribute("aria-pressed", String(item === button));
          });
          applyFilter(button);
        });
      });
    });

    topFilterButtons[0]?.click();
  </script>
</BaseLayout>
