---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.startedAt.valueOf() - a.data.startedAt.valueOf()
);

const statusLabel: Record<string, string> = {
  ongoing: "Ongoing",
  planned: "Planned",
  paused: "Paused",
  completed: "Completed"
};
---

<BaseLayout title="Research" description="Projects I'm currently working on.">
  <section class="page-intro page-shell">
    <p class="eyebrow">What our team's building</p>
    <h1>Research</h1>
    <p class="lede">projects in progress</p>
  </section>

  {projects.length > 0 ? (
    <section class="page-shell research-grid">
      {projects.map((project) => (
        <a class="research-card" href={`/research/${project.id}`}>
          <div class={`research-motif status-${project.data.status}`} aria-hidden="true">
            <span class="status-dot"></span>
          </div>
          <div class="research-card-body">
            <span class="status">{statusLabel[project.data.status]}</span>
            <h2>{project.data.title}</h2>
            <p>{project.data.summary}</p>
            {project.data.tags.length > 0 && (
              <div class="tag-list">
                {project.data.tags.map((tag) => <span>{tag.replaceAll("-", " ")}</span>)}
              </div>
            )}
          </div>
        </a>
      ))}
    </section>
  ) : (
    <section class="page-shell empty-state">
      <p>Project write-ups are coming soon.</p>
    </section>
  )}
</BaseLayout>
