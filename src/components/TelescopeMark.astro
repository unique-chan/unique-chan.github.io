---
interface Props { size?: number; }
const { size = 80 } = Astro.props;
const gradientId = `telescope-gradient-${crypto.randomUUID()}`;
const sceneId = `${gradientId}-scene`;
const clipId = `${gradientId}-clip`;
const inset = "translate(65 16) rotate(12) scale(.14) translate(-40 -40)";
// Keep the destination star on-screen while zooming. Interpolating a
// translated scale directly sends it past the edge before it comes back.
const cameraStyle = Array.from({ length: 11 }, (_, i) => {
  const progress = i / 10;
  const t = progress * progress * (3 - 2 * progress);
  const zoom = Math.pow(1 / .14, t);
  const angle = -12 * t * Math.PI / 180;
  const a = zoom * Math.cos(angle), b = zoom * Math.sin(angle);
  const c = -b, d = a;
  const x = 65 - 25 * t - a * 65 - c * 16;
  const y = 16 + 24 * t - b * 65 - d * 16;
  return `--camera-${i}:matrix(${a},${b},${c},${d},${x},${y})`;
}).join(";");
---

<svg class="telescope-mark" width={size} height={size} viewBox="0 0 80 80" aria-hidden="true">
  <defs>
    <linearGradient id={gradientId} gradientUnits="userSpaceOnUse" x1="18" y1="68" x2="64" y2="12">
      <stop class="telescope-color-start" offset="0%" />
      <stop class="telescope-color-mid" offset="50%" />
      <stop class="telescope-color-end" offset="100%" />
    </linearGradient>
    <clipPath id={clipId}><rect width="80" height="80" rx="5" /></clipPath>
    <symbol id={sceneId} viewBox="0 0 80 80" overflow="visible">
  <g fill="none" stroke={`url(#${gradientId})`} stroke-linecap="round" stroke-linejoin="round">
    <path class="telescope-distant-star" d="M19 12v6m-3-3h6" stroke-width="1.5" />
    <circle cx="42" cy="9" r="1.2" fill={`url(#${gradientId})`} stroke="none" opacity=".4" />
    <g class="telescope-star">
      <path d="m65 5 2.8 8.2L76 16l-8.2 2.8L65 27l-2.8-8.2L54 16l8.2-2.8Z" fill={`url(#${gradientId})`} fill-opacity=".15" stroke-width="1.2" />
      <circle cx="65" cy="16" r="6.5" fill="var(--bg)" stroke-width=".7" />
    </g>
    <circle class="telescope-discovery" cx="65" cy="16" r="7" stroke-width="1" />
    <g stroke-width="2.5">
      <path d="M40 44v9m0 0L25 73m15-20 15 20m-15-20v20" />
      <path d="M31 65h18" stroke-width="1.4" opacity=".55" />
    </g>
    <g class="telescope-aim">
      <path d="M40 43v-7" stroke-width="3" />
      <g transform="rotate(-25 40 36)">
        <path class="telescope-sight" d="M64 36h10" stroke-width="1.5" stroke-dasharray="2 3" />
        <rect x="28" y="30" width="31" height="12" rx="3" fill="var(--surface)" stroke-width="2.3" />
        <rect x="57" y="27" width="6" height="18" rx="2" fill="var(--bg)" stroke-width="2.3" />
        <path d="M53 31v10M33 33h14" stroke-width="1.3" opacity=".5" />
        <path d="M28 33h-7v6h7m-7-7h-3v8h3" fill="var(--surface)" stroke-width="2" />
      </g>
    </g>
    <circle cx="40" cy="44" r="3" fill="var(--bg)" stroke-width="2" />
  </g>
    </symbol>
  </defs>
  <g clip-path={`url(#${clipId})`}>
    <g class="telescope-camera" style={cameraStyle}>
      {[0, 1, 2, 3].map((depth) => (
        <g class={depth === 0 ? "telescope-outer-scene" : undefined} transform={Array(depth).fill(inset).join(" ")}>
          <use href={`#${sceneId}`} width="80" height="80" />
        </g>
      ))}
    </g>
  </g>
</svg>

<style>
  .telescope-mark { --telescope-cycle: 4.2s; display: block; }
  .telescope-camera {
    transform-box: view-box;
    transform-origin: 0 0;
    animation: telescope-inception var(--telescope-cycle) linear infinite;
  }
  .telescope-outer-scene { animation: telescope-leave var(--telescope-cycle) ease-in-out infinite; }
  .telescope-color-start { stop-color: var(--leaf-3); animation: telescope-color-start 4s ease-in-out infinite; }
  .telescope-color-mid { stop-color: var(--leaf-1); animation: telescope-color-mid 4s ease-in-out infinite; }
  .telescope-color-end { stop-color: var(--leaf-4); animation: telescope-color-end 4s ease-in-out infinite; }
  .telescope-aim { transform-origin: 40px 44px; animation: telescope-aim var(--telescope-cycle) ease-in-out infinite; }
  .telescope-star { animation: telescope-star var(--telescope-cycle) ease-in-out infinite; }
  .telescope-distant-star { animation: telescope-twinkle var(--telescope-cycle) ease-in-out infinite; }
  .telescope-sight { animation: telescope-sight var(--telescope-cycle) ease-in-out infinite; }
  .telescope-discovery { transform-origin: 65px 16px; animation: telescope-discovery var(--telescope-cycle) ease-out infinite; }
  @keyframes telescope-inception {
    0%, 20% { transform: var(--camera-0); }
    28% { transform: var(--camera-1); }
    36% { transform: var(--camera-2); }
    44% { transform: var(--camera-3); }
    52% { transform: var(--camera-4); }
    60% { transform: var(--camera-5); }
    68% { transform: var(--camera-6); }
    76% { transform: var(--camera-7); }
    84% { transform: var(--camera-8); }
    92% { transform: var(--camera-9); }
    100% { transform: var(--camera-10); }
  }
  @keyframes telescope-leave { 0%, 42% { opacity: 1; } 80%, 100% { opacity: 0; } }
  @keyframes telescope-aim {
    0%, 100% { transform: rotate(9deg); }
    18%, 45% { transform: rotate(-14deg); }
    82% { transform: rotate(-5deg); }
  }
  @keyframes telescope-star {
    0%, 100% { opacity: .55; }
    18%, 55% { opacity: 1; }
    80% { opacity: .75; }
  }
  @keyframes telescope-twinkle { 0%, 100% { opacity: .3; } 35% { opacity: .85; } 65% { opacity: .2; } }
  @keyframes telescope-sight { 0%, 10%, 75%, 100% { opacity: 0; } 20%, 45% { opacity: .6; } }
  @keyframes telescope-discovery {
    0%, 15% { transform: scale(.6); opacity: 0; }
    22% { transform: scale(.9); opacity: .55; }
    58%, 100% { transform: scale(2); opacity: 0; }
  }
  @keyframes telescope-color-start { 50% { stop-color: var(--leaf-2); } }
  @keyframes telescope-color-mid { 50% { stop-color: var(--leaf-3); } }
  @keyframes telescope-color-end { 50% { stop-color: var(--leaf-1); } }
  @media (prefers-reduced-motion: reduce) {
    .telescope-mark { --telescope-cycle: 6.4s; }
    .telescope-color-start, .telescope-color-mid, .telescope-color-end { animation-duration: 6s; }
  }
</style>
