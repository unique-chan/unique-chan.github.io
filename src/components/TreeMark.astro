---
interface Props {
  size?: number;
  class?: string;
}
const { size = 120, class: className = "" } = Astro.props;
---

<svg
  class={`tree-mark ${className}`}
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role="img"
  aria-label="Academic family tree"
>
  <g
    fill="none"
    stroke="currentColor"
    stroke-width="2.6"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <!-- trunk, and the central leader that carries on through the canopy -->
    <path d="M32 61V18" />
    <!-- first branching -->
    <path d="M14 40h36M14 40v-8M50 40v-8" />
    <!-- second branching, left and right -->
    <path d="M7 32h14M7 32v-6M21 32v-10" />
    <path d="M43 32h14M57 32v-6M43 32v-10" />
  </g>
  <g fill="none" stroke="currentColor" stroke-width="2.6">
    <circle cx="7" cy="22" r="3.5" />
    <circle cx="21" cy="18" r="3.5" />
    <circle cx="43" cy="18" r="3.5" />
    <circle cx="57" cy="22" r="3.5" />
  </g>
  <circle class="tree-mark-crown" cx="32" cy="13" r="5" />
</svg>
