---
interface Props {
  size?: number;
  class?: string;
}
const { size = 120, class: className = "" } = Astro.props;

// 12×12 brick grid: [row, firstCol, lastCol] for each run of bricks
const star = [[0, 5, 6]];
const needles = [
  [1, 5, 6], [2, 4, 7], [3, 3, 8],            // top tier
  [4, 4, 7], [5, 2, 9], [6, 1, 10],           // middle tier
  [7, 3, 8], [8, 1, 10], [9, 0, 11],          // bottom tier
];
const wood = [[10, 5, 6], [11, 4, 7]];        // trunk and stand
// needle bricks that are baubles instead
const baubles = new Set(["6,2", "4,4", "8,5", "2,6", "6,6", "4,7", "3,8", "9,8", "1,9", "6,9"]);

const pick = <T,>(xs: T[]) => xs[Math.floor(Math.random() * xs.length)];
const expand = (runs: number[][]) =>
  runs.flatMap(([row, from, to]) =>
    Array.from({ length: to - from + 1 }, (_, i) => ({ col: from + i, row })),
  );
const needleClass = (col: number, row: number) =>
  baubles.has(`${col},${row}`)
    ? `tree-bauble ${pick(["is-blue", "is-gold", "is-red"])}`
    : `tree-needle ${pick(["is-deep", "is-deep", "is-fresh"])}`;

const bricks = [
  ...expand(star).map((b) => ({ ...b, cls: "tree-mark-crown" })),
  ...expand(needles).map((b) => ({ ...b, cls: needleClass(b.col, b.row) })),
  ...expand(wood).map((b) => ({ ...b, cls: "tree-wood" })),
];
// row drives the top-to-bottom cascade; jitter keeps each brick a touch off-beat
const timing = (row: number) => `--r:${row};--j:${(Math.random() * 0.18).toFixed(2)}s`;
---

<svg
  class={`tree-mark ${className}`}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  role="img"
  aria-label="Academic family tree"
>
  {bricks.map((b) => (
    <rect
      class={b.cls}
      style={timing(b.row)}
      x={b.col * 4 + 0.35}
      y={b.row * 4 + 0.35}
      width="3.3"
      height="3.3"
      rx="0.5"
    />
  ))}
</svg>
