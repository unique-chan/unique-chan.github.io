---
interface Props { size?: number; }
const { size = 80 } = Astro.props;
const gradientId = `notebook-gradient-${crypto.randomUUID()}`;
---

<svg class="notebook-mark" width={size} height={size} viewBox="0 0 80 80" aria-hidden="true">
  <defs>
    <linearGradient id={gradientId} gradientUnits="userSpaceOnUse" x1="15" y1="65" x2="60" y2="10">
      <stop class="notebook-color-start" offset="0%" />
      <stop class="notebook-color-mid" offset="50%" />
      <stop class="notebook-color-end" offset="100%" />
    </linearGradient>
  </defs>
  <g stroke={`url(#${gradientId})`} stroke-linecap="round" stroke-linejoin="round">
    <rect x="20" y="13" width="39" height="57" rx="4" fill="var(--surface)" stroke-width="2" />
    <rect x="19" y="10" width="38" height="57" rx="4" fill="var(--bg)" stroke-width="2.2" />
    <path d="M26 12v53" stroke-width="1" opacity=".35" />
    {[20, 30, 40, 50, 60].map((y) => <path d={`M22 ${y - 2}c-10-6-10 10 0 4`} fill="none" stroke-width="2" />)}
    <g fill="none" stroke-width="1" stroke="var(--line)">
      <path d="M31 25h20M31 35h20M31 45h20M31 55h20" opacity=".55" />
    </g>
    <g fill="none" stroke-width="2.1">
      <path class="notebook-write notebook-line-one" pathLength="1" d="M31 30h20" />
      <path class="notebook-write notebook-line-two" pathLength="1" d="M31 40h20" />
      <path class="notebook-write notebook-line-three" pathLength="1" d="M31 50h14" />
    </g>
  </g>
  <g class="notebook-pen">
    <path d="M0 0 2-9 8-3Z" fill="var(--leaf-4)" />
    <path d="M2-9 20-27 26-21 8-3Z" fill={`url(#${gradientId})`} stroke="var(--bg)" stroke-width="1" stroke-linejoin="round" />
    <path d="m20-27 3-3a2 2 0 0 1 3 0l3 3a2 2 0 0 1 0 3l-3 3Z" fill="var(--leaf-4)" />
    <path d="m0 0 1-4 3 3Z" fill="var(--ink)" />
    <path d="m7-10 14-14" stroke="var(--bg)" stroke-width="1" opacity=".55" />
  </g>
</svg>

<style>
  .notebook-mark { --notebook-cycle: 5s; display: block; overflow: visible; }
  .notebook-color-start { stop-color: var(--leaf-3); animation: notebook-color-start 4s ease-in-out infinite; }
  .notebook-color-mid { stop-color: var(--leaf-1); animation: notebook-color-mid 4s ease-in-out infinite; }
  .notebook-color-end { stop-color: var(--leaf-4); animation: notebook-color-end 4s ease-in-out infinite; }
  .notebook-write { stroke-dasharray: 1; }
  .notebook-line-one { animation: notebook-line-one var(--notebook-cycle) linear infinite; }
  .notebook-line-two { animation: notebook-line-two var(--notebook-cycle) linear infinite; }
  .notebook-line-three { animation: notebook-line-three var(--notebook-cycle) linear infinite; }
  .notebook-pen { animation: notebook-pen var(--notebook-cycle) linear infinite; }
  @keyframes notebook-pen {
    0%, 5%, 100% { transform: translate(31px, 30px); }
    22% { transform: translate(51px, 30px); }
    25% { transform: translate(31px, 36px); }
    28% { transform: translate(31px, 40px); }
    45% { transform: translate(51px, 40px); }
    48% { transform: translate(31px, 46px); }
    51% { transform: translate(31px, 50px); }
    68% { transform: translate(45px, 50px); }
    76%, 86% { transform: translate(55px, 37px) rotate(8deg); }
    94% { transform: translate(31px, 26px); }
  }
  @keyframes notebook-line-one { 0%, 5%, 100% { stroke-dashoffset: 1; } 22%, 86% { stroke-dashoffset: 0; } 96% { stroke-dashoffset: 1; } }
  @keyframes notebook-line-two { 0%, 28%, 100% { stroke-dashoffset: 1; } 45%, 86% { stroke-dashoffset: 0; } 96% { stroke-dashoffset: 1; } }
  @keyframes notebook-line-three { 0%, 51%, 100% { stroke-dashoffset: 1; } 68%, 86% { stroke-dashoffset: 0; } 96% { stroke-dashoffset: 1; } }
  @keyframes notebook-color-start { 50% { stop-color: var(--leaf-2); } }
  @keyframes notebook-color-mid { 50% { stop-color: var(--leaf-3); } }
  @keyframes notebook-color-end { 50% { stop-color: var(--leaf-1); } }
  @media (prefers-reduced-motion: reduce) {
    .notebook-mark { --notebook-cycle: 8s; }
    .notebook-color-start, .notebook-color-mid, .notebook-color-end { animation-duration: 6s; }
  }
</style>
