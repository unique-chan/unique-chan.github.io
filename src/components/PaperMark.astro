---
interface Props { size?: number; }
const { size = 80 } = Astro.props;
const gradientId = `paper-gradient-${crypto.randomUUID()}`;
const lines = ["M30 35h8", "M43 35h8", "M30 40h7", "M43 40h8", "M30 45h8", "M43 45h6"];
const sheetOutline = "M26 9h20l12 12v44a3 3 0 0 1-3 3H26a3 3 0 0 1-3-3V12a3 3 0 0 1 3-3Z";
const stack = [
  { x: 8, y: 1, angle: 19, delay: 0 },
  { x: -9, y: 3, angle: -19, delay: .2 },
  { x: -5, y: 1, angle: -9, delay: .4 },
];
---

<svg class="paper-mark" width={size} height={size} viewBox="0 0 80 80" aria-hidden="true">
  <defs>
    <linearGradient id={gradientId} gradientUnits="userSpaceOnUse" x1="20" y1="68" x2="60" y2="10">
      <stop class="paper-color-start" offset="0%" />
      <stop class="paper-color-mid" offset="50%" />
      <stop class="paper-color-end" offset="100%" />
    </linearGradient>
  </defs>
  <ellipse class="paper-shadow" cx="40" cy="75" rx="20" ry="2" />
  <g fill="var(--bg)" stroke={`url(#${gradientId})`} stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    {stack.map(({ x, y, angle, delay }) => (
      <g class="paper-stack-sheet" style={`--fan-x:${x}px;--fan-y:${y}px;--fan-angle:${angle}deg;--fan-delay:${delay}s`}>
        <path d={sheetOutline} />
        <path class="paper-corner" d="M46 9v9a3 3 0 0 0 3 3h9Z" />
        <path class="paper-stack-ink" d="M30 28h20M30 35h20M30 41h17M30 47h20M30 53h15" fill="none" stroke-width="1.3" />
      </g>
    ))}
    <g class="paper-sheet">
      <path d={sheetOutline} />
      <path class="paper-corner" d="M46 9v9a3 3 0 0 0 3 3h9Z" />
      <g class="paper-ink" fill="none">
        <path class="paper-title" pathLength="1" d="M30 28h20" stroke-width="2.8" />
        {lines.map((d, i) => <path class="paper-line" style={`--line:${Math.floor(i / 2)}`} pathLength="1" d={d} stroke-width="1.6" />)}
        <path class="paper-axis" d="M30 51v10h21" stroke="var(--line)" stroke-width="1" />
        <path class="paper-graph" pathLength="1" d="m32 58 5-3 5 1 7-6" stroke-width="2" />
        <circle class="paper-point" cx="49" cy="50" r="2" fill={`url(#${gradientId})`} stroke="none" />
      </g>
    </g>
  </g>
</svg>

<style>
  .paper-mark { --paper-cycle: 4.5s; display: block; overflow: visible; }
  .paper-color-start { stop-color: var(--leaf-3); animation: paper-color-start 4s ease-in-out infinite; }
  .paper-color-mid { stop-color: var(--leaf-1); animation: paper-color-mid 4s ease-in-out infinite; }
  .paper-color-end { stop-color: var(--leaf-4); animation: paper-color-end 4s ease-in-out infinite; }
  .paper-stack-sheet {
    transform-origin: 40px 66px;
    animation: paper-multiply var(--paper-cycle) cubic-bezier(.4, 0, .2, 1) var(--fan-delay) infinite both;
  }
  .paper-stack-ink { opacity: .45; }
  .paper-sheet { transform-origin: 40px 66px; animation: paper-float var(--paper-cycle) ease-in-out infinite; }
  .paper-corner { fill: var(--surface); }
  .paper-shadow { fill: var(--ink); opacity: .08; transform-origin: 40px 75px; animation: paper-shadow var(--paper-cycle) ease-in-out infinite; }
  .paper-title, .paper-line, .paper-graph { stroke-dasharray: 1; }
  .paper-title { animation: paper-title-write var(--paper-cycle) ease-in-out infinite; }
  .paper-line { animation: paper-line-write var(--paper-cycle) ease-in-out calc(var(--line) * .18s) infinite both; }
  .paper-graph { animation: paper-graph-write var(--paper-cycle) ease-in-out infinite; }
  .paper-point { animation: paper-point-reveal var(--paper-cycle) ease-in-out infinite; }
  @keyframes paper-float {
    0%, 8%, 100% { transform: translateY(1px) rotate(-2deg); }
    32% { transform: translate(3px, -4px) rotate(4deg); }
    68% { transform: translate(1px, -2px) rotate(1deg); }
    84% { transform: translateY(-1px) rotate(-2deg); }
  }
  @keyframes paper-multiply {
    0%, 8%, 94%, 100% { transform: translate(0, 0) rotate(-2deg) scale(.94); opacity: 0; }
    16% { opacity: 1; }
    32% { transform: translate(var(--fan-x), var(--fan-y)) rotate(var(--fan-angle)) scale(.94); opacity: 1; }
    64% { transform: translate(calc(var(--fan-x) * .7), calc(var(--fan-y) - 2px)) rotate(calc(var(--fan-angle) * .8)) scale(.94); opacity: 1; }
    86% { transform: translate(0, 0) rotate(-2deg) scale(.94); opacity: 1; }
  }
  @keyframes paper-shadow { 0%, 100% { transform: scaleX(.8); opacity: .06; } 32%, 68% { transform: scaleX(1.3); opacity: .1; } }
  @keyframes paper-title-write { 0%, 4% { stroke-dashoffset: 1; } 20%, 84% { stroke-dashoffset: 0; } 98%, 100% { stroke-dashoffset: 1; } }
  @keyframes paper-line-write { 0%, 16% { stroke-dashoffset: 1; } 35%, 80% { stroke-dashoffset: 0; } 94%, 100% { stroke-dashoffset: 1; } }
  @keyframes paper-graph-write { 0%, 34% { stroke-dashoffset: 1; } 54%, 78% { stroke-dashoffset: 0; } 92%, 100% { stroke-dashoffset: 1; } }
  @keyframes paper-point-reveal { 0%, 52%, 90%, 100% { opacity: 0; } 56%, 78% { opacity: 1; } }
  @keyframes paper-color-start { 50% { stop-color: var(--leaf-2); } }
  @keyframes paper-color-mid { 50% { stop-color: var(--leaf-3); } }
  @keyframes paper-color-end { 50% { stop-color: var(--leaf-1); } }
  @media (prefers-reduced-motion: reduce) {
    .paper-mark { --paper-cycle: 7s; }
    .paper-color-start, .paper-color-mid, .paper-color-end { animation-duration: 6s; }
  }
</style>
